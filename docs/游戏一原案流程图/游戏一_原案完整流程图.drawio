        <mxCell id="title" value="03 · 场景1／任务1：走上讲台" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=28;fontColor=#23384d;fillColor=none;strokeColor=none;strokeWidth=1.5;spacing=12;text;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1">
