  <diagram id="page-1" name="01 · 全流程总览">
    <mxGraphModel dx="1660" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1260" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="01 · 全流程总览" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=28;fontColor=#23384d;fillColor=none;strokeColor=none;strokeWidth=1.5;spacing=12;text;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="25" width="1540" height="46" />
        </mxCell>
        <mxCell id="subtitle" value="依据《游戏一.docx》原文：保留身体移动、身体转向、语音表达与四个场景。未采用后续改版策划。" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#23384d;fillColor=none;strokeColor=none;strokeWidth=1.5;spacing=12;text;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="82" width="1540" height="48" />
        </mxCell>
        <mxCell id="start" value="开始 · 魔法幼儿园" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#23384d;fillColor=#e7edf5;strokeColor=#506782;strokeWidth=1.5;spacing=12;rounded=1;arcSize=30;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="140" width="620" height="100" />
        </mxCell>
        <mxCell id="adapt" value="适应环节：挥手练习&lt;br&gt;不计星星 · 详见第02页" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#23384d;fillColor=#eaf2fb;strokeColor=#557ba3;strokeWidth=1.5;spacing=12;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="260" width="620" height="100" />
        </mxCell>
        <mxCell id="s1" value="场景1：勇敢介绍自己&lt;br&gt;上讲台 → 自我介绍 → 鼓掌与星星展示&lt;br&gt;详见第03—04页" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#23384d;fillColor=#eaf2fb;strokeColor=#557ba3;strokeWidth=1.5;spacing=12;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="420" width="620" height="100" />
        </mxCell>
        <mxCell id="s2" value="场景2：主动打招呼&lt;br&gt;靠近同伴 → 语言或挥手问候&lt;br&gt;详见第05—06页" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#23384d;fillColor=#eaf2fb;strokeColor=#557ba3;strokeWidth=1.5;spacing=12;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="620" width="620" height="100" />
        </mxCell>
        <mxCell id="s3" value="场景3：主动加入&lt;br&gt;意愿分支 → 靠近 → 请求加入 → 合作&lt;br&gt;也可自由探索／问候／直接前往下一场景&lt;br&gt;详见第07—11页" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#23384d;fillColor=#eaf2fb;strokeColor=#557ba3;strokeWidth=1.5;spacing=12;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="820" width="620" height="100" />
        </mxCell>
        <mxCell id="s4" value="场景4：主动帮助&lt;br&gt;发现需求 → 拾取放置 → 回应感谢&lt;br&gt;详见第12—14页" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#23384d;fillColor=#eaf2fb;strokeColor=#557ba3;strokeWidth=1.5;spacing=12;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1040" width="620" height="100" />
        </mxCell>
        <mxCell id="legend" value="阅读方法&lt;br&gt;圆角框：行为、提示或系统反馈&lt;br&gt;菱形：判定与分支&lt;br&gt;绿色框：完成与奖励&lt;br&gt;橙色框：系统辅助或继续&lt;br&gt;页码：连接到对应任务详图" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#23384d;fillColor=#ffffff;strokeColor=#9daab8;strokeWidth=1.5;spacing=12;rounded=0;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="220" width="650" height="270" />
        </mxCell>
        <mxCell id="source" value="原文边界&lt;br&gt;未规定识别阈值与提示等待秒数，图中不添加。&lt;br&gt;上讲台不计星星；介绍失败后0星继续。&lt;br&gt;场景2靠近失败后的互动目标未明确。&lt;br&gt;场景3小汽车／玩偶替代任务未单列奖励。" style="whiteSpace=wrap;html=1;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#23384d;fillColor=#ffffff;strokeColor=#9daab8;strokeWidth=1.5;spacing=12;rounded=0;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="850" y="640" width="650" height="240" />
        </mxCell>
        <mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#52667c;strokeWidth=1.7;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#3d536a;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="adapt">
          <mxGeometry as="geometry" relative="1" />
